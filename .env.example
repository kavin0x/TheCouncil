OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: set for Grok models to use native XAI API (cheaper than OpenRouter)
XAI_API_KEY=your_xai_api_key_here

# API server authentication (single shared token for dev; use per-user API keys in production)
# IMPORTANT: Change this to a secure random string in production (min 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=your_api_secret_key_here

# Logging level (INFO for production, DEBUG for development)
LOG_LEVEL=INFO

# CORS for the web app origin(s), comma-separated
# Production: restrict to known domains only and use HTTPS
# Development: http://localhost:3000 is acceptable for local testing
CORS_ORIGINS=http://localhost:3000

# Next.js (web/): app/mcp route proxies to the API so http://localhost:3000/mcp forwards Authorization.
# NEXT_PUBLIC_API_BASE_URL in web/.env.local determines the API endpoint
# 
# SECURITY: Bearer tokens are sent with every API request.
# - Development: http://localhost:* is acceptable for local testing
# - Production: MUST use https:// to prevent token interception
#   Set NEXT_PUBLIC_API_BASE_URL=https://api.example.com in web/.env.local
# - WebSocket connections (run event feeds) also require https:// in production

# ─── Database ────────────────────────────────────────────────────────────
# SQLite (default) — file-based database, no setup required
DATABASE_URL=sqlite+aiosqlite:///./council.db
# PostgreSQL alternative (uncomment to use instead)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database
# Production PostgreSQL: Use strong password, enable SSL (sslmode=require)

# ─── Redis ───────────────────────────────────────────────────────────────
# Redis Streams message bus + WebSocket pub/sub
# Production: Enable AUTH, use strong password
REDIS_URL=redis://localhost:6379/0

# Celery broker and result backend (separate DB for isolation)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Docker sandbox (for computer-use feature) ────────────────────────────
# Optional: Docker host URL (default uses local socket)
# DOCKER_HOST=unix:///var/run/docker.sock
# Optional: model identifier used only inside sandbox/computer-use workflows
SANDBOX_CUA_MODEL=your_cua_capable_model_id_here

# ─── Web search (Tavily) ───────────────────────────────────────
# Required when web_search_enabled=true on a run
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Dev/debug flags ─────────────────────────────────────────────────────
# When REDIS_URL is unset and Celery runs in a separate process, live WebSocket events
# are forwarded to the API via HTTP. Set on the worker only; same API_SECRET_KEY as the API.
# Example (Docker): COUNCIL_API_EVENT_BRIDGE_URL=http://api:8000/internal/run-events
# COUNCIL_API_EVENT_BRIDGE_URL=
# Set to 1 to disable the in-process async worker (use when running Celery worker separately)
# COUNCIL_DISABLE_WORKER=1
# Set to 0 to enable content guardrails (default enabled)
# COUNCIL_GUARDRAILS=1
# Set to 1 to echo SQLAlchemy SQL to stdout (only for debugging)
# SQLALCHEMY_ECHO=0

# ─── PostgreSQL credentials (for docker-compose only; use strong credentials in production)
POSTGRES_USER=council
POSTGRES_PASSWORD=council
POSTGRES_DB=council
