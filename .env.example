OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: set for Grok models to use native XAI API (cheaper than OpenRouter)
XAI_API_KEY=your_xai_api_key_here

# API server authentication (single shared token for dev; use per-user tokens in production)
API_SECRET_KEY=your_api_secret_key_here

# Dev tier selection (demo only; production should resolve per-user tier)
DEFAULT_SUBSCRIPTION_TIER=pro

# CORS for the web app origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000

# Stripe payment integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRICE_ID_BASIC=price_your_basic_price_id
STRIPE_PRICE_ID_PRO=price_your_pro_price_id
STRIPE_PRICE_ID_ULTRA=price_your_ultra_price_id
STRIPE_PRICE_ID_ENTERPRISE=price_your_enterprise_price_id

# Ultra sandbox (E2B) — required for run_kind=sandbox
E2B_API_KEY=your_e2b_api_key_here
# Optional: model identifier used only inside sandbox/CUA workflows (does not change council.py default)
SANDBOX_CUA_MODEL=your_cua_capable_model_id_here
