OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: set for Grok models to use native XAI API (cheaper than OpenRouter)
XAI_API_KEY=your_xai_api_key_here

# API server authentication (single shared token for dev; use per-user API keys in production)
# IMPORTANT: Change this to a secure random string in production (min 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=your_api_secret_key_here

# Dev tier selection (demo only; production should resolve per-user tier)
DEFAULT_SUBSCRIPTION_TIER=pro

# Logging level (INFO for production, DEBUG for development)
LOG_LEVEL=INFO

# CORS for the web app origin(s), comma-separated
# Production: restrict to known domains only
CORS_ORIGINS=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────
# asyncpg connection string for SQLAlchemy async engine
# Format: postgresql+asyncpg://user:password@localhost:5432/database
# Production: Use strong password, enable SSL (sslmode=require)
DATABASE_URL=postgresql+asyncpg://council:council@localhost:5432/council

# ─── Redis ───────────────────────────────────────────────────────────────
# Redis Streams message bus + WebSocket pub/sub
# Production: Enable AUTH, use strong password
REDIS_URL=redis://localhost:6379/0

# Celery broker and result backend (separate DB for isolation)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Stripe payment integration ───────────────────────────────────────────
# PRODUCTION: Use live keys (sk_live_*), never test keys exposed to user
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Stripe Price IDs (create these in your Stripe dashboard)
STRIPE_PRICE_ID_BASIC=price_your_basic_price_id
STRIPE_PRICE_ID_PRO=price_your_pro_price_id
STRIPE_PRICE_ID_ULTRA=price_your_ultra_price_id
STRIPE_PRICE_ID_ENTERPRISE=price_your_enterprise_price_id

# ─── Zoom webhook integration ─────────────────────────────────────────────
# ZOOM_WEBHOOK_SECRET_TOKEN — Zoom app secret token for signature verification
ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token_here
# ZOOM_API_TOKEN — OAuth access token for posting to Zoom chat
ZOOM_API_TOKEN=your_zoom_api_bearer_token_here

# ─── Ultra sandbox (E2B) ──────────────────────────────────────────────────
# Required for run_kind=sandbox
E2B_API_KEY=your_e2b_api_key_here
# Optional: model identifier used only inside sandbox/CUA workflows
SANDBOX_CUA_MODEL=your_cua_capable_model_id_here

# ─── Dev/debug flags ─────────────────────────────────────────────────────
# Set to 1 to disable the in-process async worker (use when running Celery worker separately)
# COUNCIL_DISABLE_WORKER=1
# Set to 0 to enable content guardrails (default enabled)
# COUNCIL_GUARDRAILS=1
# Set to 1 to echo SQLAlchemy SQL to stdout (only for debugging)
# SQLALCHEMY_ECHO=0

# ─── PostgreSQL credentials (for docker-compose only; use strong credentials in production)
POSTGRES_USER=council
POSTGRES_PASSWORD=council
POSTGRES_DB=council
